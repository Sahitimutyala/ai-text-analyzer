# Template only: never put real keys in this file (it IS committed to Git).
# Copy it to .env.local and fill in your real key there. .env.local is git-ignored
# and is only read on the SERVER, never sent to the browser.
#
# If OPENAI_API_KEY is empty, the app falls back to mock (fake) results.
# Optional: OPENAI_MODEL=gpt-5.5 (the default)
OPENAI_API_KEY=
